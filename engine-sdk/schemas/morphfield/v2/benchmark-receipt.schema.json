{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/morphfield/v2/benchmark-receipt.schema.json",
  "title": "MorphField R2 benchmark receipt",
  "description": "A portable benchmark snapshot. Timing channels remain explicitly sourced; queue-completion wall time is not GPU shader time.",
  "x-spdx-copyright": "2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>",
  "x-spdx-license": "LicenseRef-ParticleRealms-Alpha",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "generatedAt",
    "measurementNotes",
    "run",
    "environment",
    "cohort",
    "scene",
    "representation",
    "timing",
    "pacing",
    "resources",
    "lifecycle",
    "validation",
    "events"
  ],
  "properties": {
    "$schema": { "const": "https://particlerealms.online/schemas/morphfield/v2/benchmark-receipt.schema.json" },
    "schema": { "const": "morphfield-benchmark-receipt/v2" },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "measurementNotes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "run": { "$ref": "#/$defs/run" },
    "environment": { "$ref": "#/$defs/environment" },
    "cohort": { "$ref": "#/$defs/cohort" },
    "scene": { "$ref": "#/$defs/scene" },
    "representation": { "$ref": "#/$defs/representation" },
    "timing": { "$ref": "#/$defs/timing" },
    "pacing": { "$ref": "#/$defs/pacing" },
    "resources": { "$ref": "#/$defs/resources" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "validation": { "$ref": "#/$defs/validation" },
    "events": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/jsonValue" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "nonnegativeNumber": { "type": "number", "minimum": 0 },
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "extent": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/nonnegativeInteger" },
        { "$ref": "#/$defs/nonnegativeInteger" }
      ],
      "items": false
    },
    "timingReport": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": { "$ref": "#/$defs/nonnegativeInteger" },
        "minMs": { "type": ["number", "null"], "minimum": 0 },
        "p50Ms": { "type": ["number", "null"], "minimum": 0 },
        "p90Ms": { "type": ["number", "null"], "minimum": 0 },
        "p95Ms": { "type": ["number", "null"], "minimum": 0 },
        "p97Ms": { "type": ["number", "null"], "minimum": 0 },
        "p99Ms": { "type": ["number", "null"], "minimum": 0 },
        "p999Ms": { "type": ["number", "null"], "minimum": 0 },
        "maxMs": { "type": ["number", "null"], "minimum": 0 },
        "meanMs": { "type": ["number", "null"], "minimum": 0 },
        "budgetMs": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "overBudgetCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "overBudgetRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "percentileSupport": { "$ref": "#/$defs/record" },
        "timerResolution": { "$ref": "#/$defs/record" },
        "rawSamplesMs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonnegativeNumber" }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
        "warmupMs": { "$ref": "#/$defs/nonnegativeNumber" },
        "framesObserved": { "$ref": "#/$defs/nonnegativeInteger" },
        "framesPresented": { "$ref": "#/$defs/nonnegativeInteger" }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "environment": {
      "type": "object",
      "required": ["userAgent"],
      "properties": {
        "userAgent": { "type": "string", "minLength": 1 },
        "deviceFeatures": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "limits": { "$ref": "#/$defs/record" },
        "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
        "viewport": { "$ref": "#/$defs/extent" },
        "activeExtent": { "$ref": "#/$defs/extent" },
        "capacityExtent": { "$ref": "#/$defs/extent" }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "cohort": {
      "type": "object",
      "required": ["key", "durationMs", "minimumGpuSamples", "gpuSamplesSufficient"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
        "resetCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "minimumGpuSamples": { "$ref": "#/$defs/nonnegativeInteger" },
        "gpuSamplesSufficient": { "type": "boolean" },
        "frameSamples": { "$ref": "#/$defs/nonnegativeInteger" },
        "presentationSamples": { "$ref": "#/$defs/nonnegativeInteger" },
        "timingScope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "scene": {
      "type": "object",
      "required": ["id", "fieldletCount"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/stableId" },
        "revision": { "$ref": "#/$defs/nonnegativeInteger" },
        "fieldletCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "materialCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "families": { "$ref": "#/$defs/record" },
        "semanticSpecimen": { "type": ["string", "null"] }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "representation": {
      "type": "object",
      "required": ["spatialMode", "traceTraversal"],
      "properties": {
        "spatialMode": { "type": "string", "minLength": 1 },
        "bvhNodeCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "bvhDepth": { "$ref": "#/$defs/nonnegativeInteger" },
        "certifiedFieldlets": { "$ref": "#/$defs/nonnegativeInteger" },
        "substantivePhases": { "$ref": "#/$defs/nonnegativeInteger" },
        "markerOnlyPhases": { "$ref": "#/$defs/nonnegativeInteger" },
        "analyticInstructionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "traceTraversal": { "$ref": "common.schema.json#/$defs/jsonValue" },
        "scaleAdmission": { "$ref": "common.schema.json#/$defs/jsonValue" }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    },
    "timing": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/timingReport" }
    },
    "pacing": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "queueDepth": { "$ref": "#/$defs/nonnegativeInteger" },
        "maximumQueueDepth": { "$ref": "#/$defs/nonnegativeInteger" },
        "queueCapacity": { "$ref": "#/$defs/nonnegativeInteger" },
        "queueLimitedFrames": { "$ref": "#/$defs/nonnegativeInteger" },
        "rAFSpikesOver25Ms": { "$ref": "#/$defs/nonnegativeInteger" },
        "longFramesOver50Ms": { "$ref": "#/$defs/nonnegativeInteger" },
        "observedLongTasks": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "resources": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "ownedCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "ownedBytes": { "$ref": "#/$defs/nonnegativeInteger" },
        "sceneUploadedBytes": { "$ref": "#/$defs/nonnegativeInteger" },
        "heapBytes": { "type": ["integer", "null"], "minimum": 0 },
        "heapDeltaBytes": { "type": ["integer", "null"] }
      }
    },
    "lifecycle": { "$ref": "#/$defs/record" },
    "validation": {
      "type": "object",
      "required": ["gpuTimingSource"],
      "properties": {
        "gpuTimingSource": { "enum": ["timestamp-query", "unavailable"] },
        "gpuTimingReason": { "type": ["string", "null"] },
        "gpuTimestampSamples": { "$ref": "#/$defs/nonnegativeInteger" },
        "errors": { "$ref": "#/$defs/nonnegativeInteger" },
        "ownership": { "$ref": "#/$defs/record" }
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
    }
  }
}
