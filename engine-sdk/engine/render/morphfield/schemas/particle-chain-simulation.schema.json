{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/morphfield/v2/particle-chain-simulation.schema.json",
  "title": "MorphField particle-chain Nexel snapshot metadata",
  "description": "The canonical simulation metadata emitted by createParticleChainNexelDescriptors(). Solver state remains caller-owned and is not embedded here.",
  "x-spdx-copyright": "2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>",
  "x-spdx-license": "LicenseRef-ParticleRealms-Alpha",
  "type": "object",
  "required": ["adapter", "chainId", "role", "index", "authority", "sourceRevision"],
  "properties": {
    "adapter": { "const": "particle-chain-nexel-snapshot" },
    "chainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "role": { "enum": ["node", "link"] },
    "index": { "type": "integer", "minimum": 0, "maximum": 4095 },
    "authority": { "enum": ["authoritative", "visual"] },
    "sourceRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sourceAuthority": { "enum": ["authoritative", "visual"] },
    "motionModel": { "const": "rigid-link-envelope" },
    "collisionRole": { "const": "queryable-visual-skin" }
  },
  "oneOf": [
    {
      "properties": { "role": { "const": "node" } },
      "not": {
        "anyOf": [
          { "required": ["sourceAuthority"] },
          { "required": ["motionModel"] },
          { "required": ["collisionRole"] }
        ]
      }
    },
    {
      "required": ["sourceAuthority", "motionModel", "collisionRole"],
      "properties": {
        "role": { "const": "link" },
        "authority": { "const": "visual" }
      }
    }
  ],
  "additionalProperties": false
}
