{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/morphfield/v2/patch.schema.json",
  "title": "MorphField R2 canonical Nexel patch",
  "description": "A normalized monotonic scene patch. Ordering, duplicate IDs, skipped revisions, and stale revisions remain runtime invariants.",
  "x-spdx-copyright": "2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>",
  "x-spdx-license": "LicenseRef-ParticleRealms-Alpha",
  "type": "object",
  "required": ["$schema", "schema", "version", "revision", "completeSnapshot", "upsert", "remove"],
  "properties": {
    "$schema": { "const": "https://particlerealms.online/schemas/morphfield/v2/patch.schema.json" },
    "schema": { "const": "morphfield-nexel-patch" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "completeSnapshot": { "type": "boolean" },
    "upsert": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "nexel.schema.json" }
    },
    "remove": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "common.schema.json#/$defs/stableId" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "completeSnapshot": { "const": true } }, "required": ["completeSnapshot"] },
      "then": { "properties": { "remove": { "maxItems": 0 } } }
    }
  ],
  "additionalProperties": false
}
