{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/compute/rpc-request.v1.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>; SPDX-License-Identifier: LicenseRef-ParticleRealms-Alpha",
  "title": "Compute isolated-package RPC request v1",
  "description": "JSON metadata projection of the existing structured-clone envelope. Native payloads are described by native-value markers for validation only; transport retains the original typed arrays and buffers. Source-window/nonce equality and admission precede payload validation.",
  "type": "object",
  "properties": {
    "__pkgRpc": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__pkgNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ns": {
      "const": "compute"
    },
    "method": {
      "enum": [
        "capabilities",
        "listOperations",
        "copyFrom",
        "readCopy",
        "releaseBuffer",
        "submit",
        "wait",
        "cancel",
        "releaseJob",
        "stats",
        "inspectCapabilities",
        "setAccelerationEnabled"
      ]
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "https://particlerealms.online/schemas/compute/native-value.v1.schema.json"
      },
      "maxItems": 2
    }
  },
  "required": [
    "__pkgRpc",
    "__pkgNonce",
    "ns",
    "method",
    "args"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "capabilities",
              "stats",
              "inspectCapabilities"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "listOperations"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 0,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "moduleId": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "readCopy",
              "releaseBuffer",
              "wait",
              "cancel",
              "releaseJob"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "$ref": "https://particlerealms.online/schemas/compute/handle.v1.schema.json"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "setAccelerationEnabled"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "copyFrom"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 1,
            "maxItems": 2,
            "prefixItems": [
              {
                "allOf": [
                  {
                    "$ref": "https://particlerealms.online/schemas/compute/native-value.v1.schema.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "$computeType": {
                        "enum": [
                          "typed-array",
                          "array-buffer"
                        ]
                      }
                    },
                    "required": [
                      "$computeType"
                    ]
                  }
                ]
              },
              {
                "$ref": "#/$defs/rawBufferDescriptor"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "submit"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "minItems": 1,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "$ref": "#/$defs/rawRequest"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "rawRequest": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "https://particlerealms.online/schemas/compute/handle.v1.schema.json"
          }
        },
        "parameters": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "https://particlerealms.online/schemas/compute/native-value.v1.schema.json"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "backend": {
                  "anyOf": [
                    {
                      "enum": [
                        "auto",
                        "js",
                        "wasm-scalar",
                        "wasm-simd",
                        "wasm-threads",
                        "wasm-threads-simd",
                        "webgpu"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputLocation": {
                  "anyOf": [
                    {
                      "enum": [
                        "cpu",
                        "gpu"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "precision": {
                  "anyOf": [
                    {
                      "enum": [
                        "exact",
                        "f32",
                        "f64"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "priority": {
                  "anyOf": [
                    {
                      "enum": [
                        "background",
                        "interactive"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "timeoutMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 300000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rawBufferDescriptor": {
      "type": "object",
      "properties": {
        "dtype": {
          "enum": [
            "u8",
            "u8clamped",
            "i8",
            "u16",
            "i16",
            "u32",
            "i32",
            "f32",
            "f64"
          ]
        },
        "elementType": {
          "enum": [
            "u8",
            "u8clamped",
            "i8",
            "u16",
            "i16",
            "u32",
            "i32",
            "f32",
            "f64"
          ]
        },
        "shape": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minItems": 1,
                  "maxItems": 8
                },
                {
                  "allOf": [
                    {
                      "$ref": "https://particlerealms.online/schemas/compute/native-value.v1.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "$computeType": {
                          "const": "typed-array"
                        },
                        "length": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 8
                        }
                      },
                      "required": [
                        "$computeType",
                        "length"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
