{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/compute/statistics.v1.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>; SPDX-License-Identifier: LicenseRef-ParticleRealms-Alpha",
  "title": "Compute resource statistics v1",
  "description": "Snapshot of tracked cumulative counters, current resource accounting, and bounded recent activity. Ratios may exceed one; schema validation does not reserve memory or enforce live admission.",
  "type": "object",
  "properties": {
    "completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cancelled": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peakCpuBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owners": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "buffers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "queued": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "running": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cpuBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "heapBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gpuBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "calibratedRanges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accelerationEnabled": {
      "type": "boolean"
    },
    "lastBackend": {
      "anyOf": [
        {
          "enum": [
            "js",
            "wasm-scalar",
            "wasm-simd",
            "wasm-threads",
            "wasm-threads-simd",
            "webgpu"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lastError": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 128
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "backendCounts": {
      "type": "object",
      "properties": {
        "js": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wasm-scalar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wasm-simd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wasm-threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wasm-threads-simd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "webgpu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "cpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ownerCpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ownerGpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queuedJobsPerOwner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "buffers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ownerBuffers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedJobsPerOwner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrentJobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cpuBytes",
        "gpuBytes",
        "ownerCpuBytes",
        "ownerGpuBytes",
        "queuedJobsPerOwner",
        "buffers",
        "ownerBuffers",
        "retainedJobsPerOwner",
        "workers",
        "concurrentJobs",
        "defaultTimeoutMs"
      ],
      "additionalProperties": false
    },
    "pressure": {
      "type": "object",
      "properties": {
        "cpuRatio": {
          "type": "number",
          "minimum": 0
        },
        "gpuRatio": {
          "type": "number",
          "minimum": 0
        },
        "ownerQueuePeakRatio": {
          "type": "number",
          "minimum": 0
        },
        "ownerRetainedPeakRatio": {
          "type": "number",
          "minimum": 0
        },
        "oldestQueuedMs": {
          "type": "number",
          "minimum": 0
        },
        "queuedOwners": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedJobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cpuRatio",
        "gpuRatio",
        "ownerQueuePeakRatio",
        "ownerRetainedPeakRatio",
        "oldestQueuedMs",
        "queuedOwners",
        "retainedJobs"
      ],
      "additionalProperties": false
    },
    "recentJobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recentJob"
      },
      "maxItems": 24
    }
  },
  "required": [
    "completed",
    "failed",
    "cancelled",
    "peakCpuBytes",
    "owners",
    "buffers",
    "jobs",
    "queued",
    "running",
    "cpuBytes",
    "heapBytes",
    "gpuBytes",
    "workers",
    "calibratedRanges",
    "accelerationEnabled",
    "lastBackend",
    "lastError",
    "backendCounts",
    "limits",
    "pressure",
    "recentJobs"
  ],
  "additionalProperties": false,
  "$defs": {
    "recentJob": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requestedBackend": {
          "enum": [
            "auto",
            "js",
            "wasm-scalar",
            "wasm-simd",
            "wasm-threads",
            "wasm-threads-simd",
            "webgpu"
          ]
        },
        "backend": {
          "anyOf": [
            {
              "enum": [
                "js",
                "wasm-scalar",
                "wasm-simd",
                "wasm-threads",
                "wasm-threads-simd",
                "webgpu"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "f32",
            "f64"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "queueMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "runMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "totalMs": {
          "type": "number",
          "minimum": 0
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "workers": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "requestedBackend",
        "backend",
        "precision",
        "status",
        "queueMs",
        "runMs",
        "totalMs",
        "inputBytes",
        "outputBytes",
        "workers",
        "finishedAt",
        "errorCode"
      ],
      "additionalProperties": false
    }
  }
}
