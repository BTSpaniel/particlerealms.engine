{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particlerealms.online/schemas/compute/rpc-response.v1.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Jake Wehmeier (BTSpaniel) <https://github.com/BTSpaniel>; SPDX-License-Identifier: LicenseRef-ParticleRealms-Alpha",
  "title": "Compute isolated-package RPC response v1",
  "description": "JSON metadata projection of the existing structured-clone response. Successful native binary/IEEE values remain unchanged on the wire; absent optional fields are omitted from the validation projection.",
  "type": "object",
  "properties": {
    "__pkgRpcResult": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__pkgNonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "ok": {
      "type": "boolean"
    },
    "value": {
      "$ref": "https://particlerealms.online/schemas/compute/native-value.v1.schema.json"
    },
    "error": {
      "$ref": "https://particlerealms.online/schemas/compute/error.v1.schema.json"
    }
  },
  "required": [
    "__pkgRpcResult",
    "__pkgNonce",
    "ok"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "__pkgRpcResult": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "__pkgNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "ok": {
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "$computeType": {
                  "const": "wire-value"
                }
              },
              "required": [
                "$computeType"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "https://particlerealms.online/schemas/compute/error.v1.schema.json"
        }
      },
      "required": [
        "__pkgRpcResult",
        "__pkgNonce",
        "ok"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          "else": {
            "required": [
              "error"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Admission-time response metadata after the independent binary wire validator has accepted the original value. The wire-value marker is a validation receipt only, never a transported encoding or proof of authority."
    }
  }
}
